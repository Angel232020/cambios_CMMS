@model IEnumerable<CMMS.Models.TipoServicio>

@{
    ViewData["Title"] = "Tipos de Servicio";
}

<link rel="stylesheet" href="~/css/All.css" />

<div class="container-fluid px-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

        <h1 class="display-6 fw-bold text-dark m-0">
            Gestión de Tipos de Servicio
        </h1>

        <a asp-action="Create" class="btn btn-primary shadow-sm">
            Crear nuevo tipo
        </a>

    </div>

    <!-- CARD PRINCIPAL -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Nombre
                            </th>

                            <th style="width: 50%;">
                                Descripción
                            </th>

                            <th class="text-end pe-4">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- NOMBRE -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-2">

                                        <span class="fw-semibold">
                                            @item.Nombre
                                        </span>

                                    </div>

                                </td>

                                <!-- DESCRIPCIÓN -->
                                <td>

                                    <div class="text-truncate-2"
                                         title="@item.Descripcion">

                                        @item.Descripcion

                                    </div>

                                </td>

                                <!-- ACCIONES -->
                                <td class="text-nowrap text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdTipoServicio"
                                           class="btn btn-sm btn-outline-secondary">

                                            Editar

                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.IdTipoServicio"
                                           class="btn btn-sm btn-outline-info">

                                            Detalle

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdTipoServicio"
                                           class="btn btn-sm btn-outline-danger">

                                            Borrar

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
