@using Microsoft.AspNetCore.Http

@{
    var rolId = Context.Session.GetString("IdRol");

    if (string.IsNullOrEmpty(rolId))
    {
        Context.Response.Redirect("/Account/Login");
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMMS</title>

    <!-- 1. BOOTSTRAP (Esencial para que tus tablas y botones tengan color) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- 2. ICONOS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- 3. TUS ESTILOS PERSONALIZADOS -->
    <link rel="stylesheet" href="~/css/All.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuAsesor.css" asp-append-version="true" />

    <style>
        .container-menu { display: flex; height: 100vh; overflow: hidden; }
        /* El fondo #f4f4f4 ayuda a que las tarjetas blancas de Bootstrap resalten */
        .main-content { flex: 1; overflow-y: auto; background-color: #f8f9fa; }
        .content-body { padding: 25px; }
        .sidebar { min-width: 250px; transition: all 0.3s; }
        .sidebar.collapsed { min-width: 80px; width: 80px; }
    </style>
</head>
<body>
    <div class="container-menu">
        <!-- SIDEBAR -->
        <div class="sidebar" id="sidebar">
            <div class="top-section">
                <h2 class="logo-text">Taller X-GMASS</h2>
                <ul class="menu-links">
                    @await Html.PartialAsync("_menuSegunRol")
                </ul>
            </div>
            <div class="logout">
                <a asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-right"></i> <span>Cerrar sesión</span>
                </a>
            </div>
        </div>

        <!-- CONTENIDO DINÁMICO -->
        <div class="main-content">
            <!-- Barra superior para el botón de menú -->
            <div class="p-2 bg-white border-bottom shadow-sm">
                <button class="btn btn-light border" onclick="toggleMenu()">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            
            <!-- CONTENEDOR DE LAS VISTAS (Aquí se cargan tus tablas) -->
            <div class="content-body">
                @RenderBody() 
            </div>
        </div>
    </div>

    <!-- SCRIPTS DE BOOTSTRAP Y JQUERY -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function toggleMenu() {
            document.getElementById("sidebar").classList.toggle("collapsed");
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
