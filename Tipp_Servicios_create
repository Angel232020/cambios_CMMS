@model CMMS.Models.TipoServicio

@{
    ViewData["Title"] = "Nuevo Tipo de Servicio";
}

<link rel="stylesheet" href="~/css/All.css" />

<div class="container-fluid px-4">

    <!-- ENCABEZADO -->
    <div class="mt-4 mb-4">

        <h1 class="display-6 fw-bold text-dark">
            Registrar Tipo de Servicio
        </h1>

        <p class="text-muted">
            Cree una nueva categoría de servicio para clasificar órdenes y mantenimientos.
        </p>

    </div>

    <div class="row">

        <!-- FORMULARIO -->
        <div class="col-lg-9 col-xl-8">

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-header bg-white py-3 border-bottom">

                    <h5 class="card-title mb-0 text-primary">
                        <i class="bi bi-tools me-2"></i>
                        Información del Servicio
                    </h5>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="row g-4">

                            <!-- NOMBRE -->
                            <div class="col-md-6">

                                <label asp-for="Nombre"
                                       class="form-label fw-bold">

                                    Nombre del Servicio

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-tag"></i>
                                    </span>

                                    <input asp-for="Nombre"
                                           class="form-control shadow-none"
                                           placeholder="Ej: Mantenimiento Preventivo" />

                                </div>

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- DESCRIPCIÓN -->
                            <div class="col-12">

                                <label asp-for="Descripcion"
                                       class="form-label fw-bold">

                                    Descripción

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light align-items-start pt-3">
                                        <i class="bi bi-card-text"></i>
                                    </span>

                                    <textarea asp-for="Descripcion"
                                              class="form-control shadow-none"
                                              rows="5"
                                              placeholder="Describa el alcance o finalidad del tipo de servicio..."></textarea>

                                </div>

                                <span asp-validation-for="Descripcion"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <!-- BOTONES -->
                        <div class="mt-4 pt-3 border-top d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4 shadow-sm">

                                <i class="bi bi-plus-circle me-2"></i>
                                Registrar Tipo

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <!-- PANEL DERECHO -->
        <div class="col-lg-3">

            <div class="card border-0 shadow-sm bg-light">

                <div class="card-body">

                    <h6 class="fw-bold mb-3 small text-uppercase">
                        <i class="bi bi-lightbulb me-2 text-primary"></i>
                        Buenas Prácticas
                    </h6>

                    <p class="small text-muted">

                        Los tipos de servicio permiten organizar y clasificar
                        correctamente las órdenes de trabajo dentro del sistema CMMS.

                    </p>

                    <hr>

                    <p class="small text-muted mb-0">

                        Mantenga categorías claras y reutilizables para facilitar:
                        <strong>
                            reportes,
                            programación,
                            métricas
                            y seguimiento técnico.
                        </strong>

                    </p>

                </div>

            </div>

            <div class="text-center mt-4 opacity-50 d-none d-lg-block">

                <i class="bi bi-diagram-3"
                   style="font-size: 5rem;">
                </i>

            </div>

        </div>

    </div> <!-- FIN ROW -->

</div> <!-- FIN CONTAINER -->

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
